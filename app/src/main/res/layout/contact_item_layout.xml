<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name = "model"
            type = "mu.location.savmed.ui.contacts.models.ContactAvatarModel"/>
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <FrameLayout
                android:id="@+id/frameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <include
                    android:id="@+id/avatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    layout="@layout/contact_avatar_medium"
                    bind:model="@{model}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

<!--                <de.hdodenhof.circleimageview.CircleImageView-->
<!--                    android:id="@+id/profileImage"-->
<!--                    android:layout_width="60dp"-->
<!--                    android:layout_height="60dp"-->
<!--                    android:layout_gravity="top|start"-->
<!--                    android:layout_marginStart="10dp"-->
<!--                    coil="@{model.picturePath}"-->
<!--                    android:contentDescription="Profile Image"-->
<!--                    app:civ_border_width="2dp"-->
<!--                    app:civ_border_color="@color/green_main_100_alpha_50"-->
<!--                    app:civ_border_overlay="true"/>-->

<!--                &lt;!&ndash; Online Status Indicator &ndash;&gt;-->
<!--                <View-->
<!--                    android:id="@+id/onlineStatusIndicator"-->
<!--                    android:layout_width="20dp"-->
<!--                    android:layout_height="20dp"-->
<!--                    android:layout_marginTop="38dp"-->
<!--                    android:background="@drawable/contact_online_status"-->
<!--                    app:layout_constraintBottom_toBottomOf="parent"-->
<!--                    app:layout_constraintTop_toTopOf="parent"-->
<!--                    android:layout_marginStart="50dp"/>-->

                <!-- Main Contact Info -->
                <LinearLayout
                    android:id="@+id/contactInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginStart="80dp"
                    android:layout_marginTop="12dp" >

                    <TextView
                        android:id="@+id/contactNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{model.name,default=fatima}"
                        android:textAlignment="viewStart"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lastSeenText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="10 min ago"
                        android:textColor="@android:color/darker_gray"
                        android:textSize="12sp" />
                </LinearLayout>


                <!-- Expandable View -->
                <LinearLayout
                    android:id="@+id/expandableView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:padding="10dp">

<!--                    &lt;!&ndash; Contact Info Button &ndash;&gt;-->
<!--                    <com.google.android.material.button.MaterialButton-->
<!--                        android:id="@+id/deleteButton"-->
<!--                        style="@style/Widget.MaterialComponents.Button.TextButton"-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:text="Delete Contact"-->
<!--                        app:icon="@android:drawable/ic_menu_delete"-->
<!--                        android:drawablePadding="10dp" />-->

<!--                    &lt;!&ndash; Edit Contact Button &ndash;&gt;-->
<!--                    <com.google.android.material.button.MaterialButton-->
<!--                        android:id="@+id/editButton"-->
<!--                        style="@style/Widget.MaterialComponents.Button.TextButton"-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:text="Edit Contact"-->
<!--                        app:icon="@android:drawable/ic_menu_edit"-->
<!--                        android:drawablePadding="10dp" />-->

                    <androidx.cardview.widget.CardView
                        android:id="@+id/contactListExpandview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="horizontal"

                            android:weightSum="4">


                            <!-- Chat Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chatButton"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="35dp"
                                android:layout_gravity="center"
                                android:layout_marginEnd="20dp"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:gravity="center_horizontal|center_vertical"
                                app:icon="@android:drawable/ic_menu_send"
                                app:iconGravity="top" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/deleteButton"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="35dp"
                                android:layout_gravity="center"
                                android:layout_marginEnd="20dp"
                                android:layout_weight="1"
                                app:icon="@android:drawable/ic_delete"
                                app:iconGravity="top" />

                            <!-- Edit Contact Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/infoButton"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="35dp"
                                android:layout_gravity="center"
                                android:layout_marginEnd="20dp"
                                android:layout_weight="1"
                                app:icon="@android:drawable/ic_menu_info_details"
                                app:iconGravity="top" />


                            <!-- Video Call Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/videoCallConatactList"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="35dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:layout_marginEnd="10dp"
                                app:icon="@android:drawable/presence_video_away"
                                app:iconGravity="textTop" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp"
                    android:weightSum="1">

                    <!-- Call Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/callButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        app:icon="@android:drawable/ic_menu_call"
                        android:gravity="center"/>

                </LinearLayout>


            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</layout>
