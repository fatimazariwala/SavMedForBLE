<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:bind="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>
        <variable
            name="viewModel"
            type="mu.location.savmed.ui.contacts.viewModels.ContactViewModel" />
    </data>


<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="18dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context="mu.location.savmed.ui.contacts.fragments.NewOrEditContactFragment"
        android:padding="50dp">

        <!-- HEading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:fontFamily="@font/adlam_display"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Add/Edit Contact"
            android:textColor="#151515"
            android:textSize="30dp" />

        <!-- Sub HEading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="10dp"
            android:text="Please Enter the details."
            android:textSize="12dp" />

<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_gravity="left"-->
<!--            android:layout_marginTop="20dp"-->
<!--            android:fontFamily="@font/adlam_display"-->
<!--            android:text="Full Name:"-->
<!--            android:textSize="24sp" />-->

<!--        <EditText-->
<!--            android:id="@+id/firstName"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:hint="First Name"-->
<!--            android:text="@={viewModel.firstName}"-->
<!--            android:layout_marginTop="10dp"-->
<!--            android:layout_marginBottom="10dp"-->
<!--            android:inputType="text"-->
<!--            android:padding="8dp"-->
<!--            android:background="@color/cardview_light_background" />-->


<!--        <EditText-->
<!--            android:id="@+id/lastName"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="@={viewModel.lastName}"-->
<!--            android:hint="Last Name"-->
<!--            android:inputType="text"-->
<!--            android:padding="8dp"-->
<!--            android:background="@color/cardview_light_background" />-->


        <!-- Add contacts profile image -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp">

            <ImageView
                android:id="@+id/contactImagebackground"
                android:layout_width="@dimen/avatar_big_size"
                android:layout_height="@dimen/avatar_big_size"
                android:layout_gravity="center"
                coil="@{viewModel.picturePath}"
                android:background="@drawable/circular_shape"
                android:fadeScrollbars="true"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/overlay"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/smiley"
                android:visibility="@{viewModel.picturePath.empty ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toBottomOf="@id/avatar"
                app:layout_constraintEnd_toEndOf="@id/avatar"
                app:layout_constraintStart_toStartOf="@id/avatar"
                app:layout_constraintTop_toTopOf="@id/avatar"
                app:tint="@color/gray_main2_600" />

        </FrameLayout>

        <!-- BElow is the button to manage profile image icon -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addProfileImage"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/adlam_display"
                android:text="Add Image"
                android:textColor="#000000"
                android:visibility="@{viewModel.picturePath.empty ? View.VISIBLE : View.GONE}"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="@{!viewModel.picturePath.empty ? View.VISIBLE : View.GONE,default=gone}"
                android:gravity="center_horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/UpdateProfileImage"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/adlam_display"
                    android:text="Update"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.254"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/delete_button"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/adlam_display"
                    android:text="Delete Image"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.763"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0" />


            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <!-- END Add contacts profile image -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Add as emergency contact: "
                android:gravity="center_vertical">

            </TextView>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/edit_contact_emergencycontact_switch"
                android:checked="@={viewModel.isEmr}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </androidx.appcompat.widget.SwitchCompat>

        </LinearLayout>

        <!-- First Name EditText -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="20dp"
            app:helperText="Required*"
            app:helperTextTextColor="@color/red_danger_500"
            app:boxStrokeColor="@color/blue_info_500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/firstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@={viewModel.firstName}"
                android:hint="First Name"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Last Name EditText -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:helperText="Required*"
            app:helperTextTextColor="@color/red_danger_500"
            app:boxStrokeColor="@color/blue_info_500"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/lastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@={viewModel.lastName}"
                android:hint="Last Name"
                android:inputType="text"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Relation EditText -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="10dp"
            app:helperText="Required*"
            app:helperTextTextColor="@color/red_danger_500"
            app:boxStrokeColor="@color/blue_info_500"
            android:layout_marginTop="15dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/Relation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Relation"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- PhoneNumber EditText -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="10dp"
            app:boxStrokeColor="@color/blue_info_500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/PhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone Number"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- UserName EditText -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="10dp"
            app:boxStrokeColor="@color/blue_info_500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/sipAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Username"
                android:text="@={viewModel.sipUri}"
                android:inputType="text"
                />
        </com.google.android.material.textfield.TextInputLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/adlam_display"
            android:text="Other Details:"
            android:textSize="24sp"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/addEmailButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Email"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:id="@+id/emailsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- res/layout/email_input_layout.xml -->

        </LinearLayout>

        <Button
            android:id="@+id/addAddressButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Address"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:id="@+id/addressesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- The dynamic address fields will be added here -->

        </LinearLayout>

        <!-- Notes field for Contacts EditText -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="20dp"
            app:helperText="Required*"
            app:helperTextTextColor="@color/red_danger_500"
            app:boxStrokeColor="@color/blue_info_500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/Notes"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:text="@={viewModel.firstName}"
                android:hint="Notes"
                android:gravity="top"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <EditText
            android:id="@+id/organization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Organization"
            android:text="@={viewModel.organization}"
            android:inputType="text"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:padding="8dp"
            android:background="@color/cardview_light_background" />

        <EditText
            android:id="@+id/jobTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Position"
            android:text="@={viewModel.jobTitle}"
            android:layout_marginBottom="10dp"
            android:inputType="text"
            android:padding="8dp"
            android:background="@color/cardview_light_background" />

        <Button
            android:id="@+id/buttonSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/black"
            android:textColor="@android:color/white" />

    </LinearLayout>

</ScrollView>


</layout>