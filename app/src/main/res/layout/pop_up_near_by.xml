<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="16dp">

    <ImageView
        android:id="@+id/btn_cancel"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Close button"
        app:tint="@color/black" />

    <!-- Text above the circle -->
    <TextView
        android:id="@+id/tv_above_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="32dp"
        android:text="Your Distance"
        android:textSize="18dp"
        android:textColor="@android:color/black"
        android:textStyle="bold"/>

    <!-- Circle with text inside -->
    <FrameLayout
        android:id="@+id/circle_container"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_below="@id/tv_above_circle"
        android:layout_centerHorizontal="true"
        android:background="@drawable/circle_background">

        <TextView
            android:id="@+id/tsos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="0dp"
            android:layout_marginTop="25dp"
            android:text="SOS"
            android:textColor="@color/red"
            android:textSize="30dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="0dp"
            android:layout_marginTop="70dp"
            android:text="3m away"
            android:textColor="@color/blue_main_700"
            android:textSize="24dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_approx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="80dp"
            android:text="[approx dist given]"
            android:textSize="14dp"
            android:textColor="@android:color/black"
            android:textStyle="bold"/>

    </FrameLayout>

    <!-- OK button -->
    <Button
        android:id="@+id/btn_ok"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/circle_container"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:padding="8dp"
        android:text="OK"
        android:textSize="16dp"
        android:backgroundTint="@android:color/holo_blue_light"
        android:textColor="@android:color/white"/>

</RelativeLayout>
